rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().size() <= 3 &&
             data.email is string &&
             data.email.size() <= 255 &&
             data.createdAt is timestamp &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100));
    }

    function isValidFavorite(data, userId) {
      return data.keys().hasAll(['userId', 'itemId', 'itemType', 'title', 'createdAt']) &&
             data.keys().size() <= 7 &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.itemId is string && data.itemId.size() <= 128 &&
             data.itemType in ['subsystem', 'benchmark', 'rc_gate', 'profile', 'code_snippet'] &&
             data.title is string && data.title.size() <= 200 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 500)) &&
             data.createdAt is timestamp;
    }

    function isValidSnapshot(data, userId) {
      return data.keys().hasAll(['userId', 'scenarioId', 'scenarioTitle', 'turnIndex', 'turnAction', 'createdAt']) &&
             data.keys().size() <= 14 &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.scenarioId is string && data.scenarioId.size() <= 128 &&
             data.scenarioTitle is string && data.scenarioTitle.size() <= 200 &&
             data.turnIndex is number && data.turnIndex >= 0 &&
             data.turnAction is string && data.turnAction.size() <= 300 &&
             (!('tokensCount' in data) || (data.tokensCount is number && data.tokensCount >= 0)) &&
             (!('vramPages' in data) || (data.vramPages is number && data.vramPages >= 0)) &&
             (!('dramPages' in data) || (data.dramPages is number && data.dramPages >= 0)) &&
             (!('nvmePages' in data) || (data.nvmePages is number && data.nvmePages >= 0)) &&
             (!('nodeCount' in data) || (data.nodeCount is number && data.nodeCount >= 0)) &&
             (!('imageData' in data) || (data.imageData is string && data.imageData.size() <= 800000)) &&
             data.createdAt is timestamp;
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && 
                    incoming().createdAt == existing().createdAt &&
                    incoming().email == existing().email &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName']);
      allow delete: if isOwner(userId);

      // Subcollection of user's favorited items
      match /favorites/{favoriteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(favoriteId) && isValidFavorite(incoming(), userId) && incoming().createdAt == request.time;
        allow delete: if isOwner(userId) && isValidId(favoriteId);
      }

      // Subcollection of user's simulation snapshots
      match /snapshots/{snapshotId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(snapshotId) && isValidSnapshot(incoming(), userId) && incoming().createdAt == request.time;
        allow delete: if isOwner(userId) && isValidId(snapshotId);
      }
    }
  }
}
